# Copy these variables to Vercel Dashboard > Project Settings > Environment Variables
# Do NOT commit real values to git

PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=Sara7a

# JWT Secrets
USER_ACCESS_TOKEN_SECRET_KEY=your_user_secret_here
ADMIN_ACCESS_TOKEN_SECRET_KEY=your_admin_secret_here

# Encryption
SALT_ROUND=8
ENC_IV_LENGTH=16
ENC_KEY=your_32_char_encryption_key_here

# Email (Nodemailer)
APP_EMAIL=your_email@gmail.com
APP_EMAIL_PASSWORD=your_app_password_here
